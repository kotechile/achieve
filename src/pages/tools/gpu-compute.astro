---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import JsonLd from '../../components/JsonLd.astro';
import LocalVsCloudGpuCalculator from '../../components/calculators/react/LocalVsCloudGpuCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedArticleCard from '../../components/calculators/RelatedArticleCard.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';

const calculator = getCalculatorBySlug('gpu-compute');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const description =
	'Model a local GPU cluster against rented capacity: street hardware pricing, enterprise software licences, TDP load, persistent storage, and the utilization floor where owning stops paying.';

const faqItems = [
	{
		question: 'What goes into the owned-cost side?',
		answer:
			'The accelerator at street price, system components, rack commissioning, electricity under sustained TDP load, an annual maintenance reserve, NVIDIA AI Enterprise seats, and the opportunity cost of the capital tied up. Depreciation is modelled as residual-value decay, because the resale floor moves every generation.'
	},
	{
		question: 'Why does software licensing sit next to hardware?',
		answer:
			'NVIDIA AI Enterprise lists at $4,500 per GPU per year and clears at $22,500 for a five-year term. On an L40S or MI300X that matches the purchase price of the card, so a hardware-only comparison understates owned cost by roughly half.'
	},
	{
		question: 'Why does persistent storage show up on the rental side?',
		answer:
			'Rental price per GPU-hour is the visible line. Storage for datasets and checkpoints is the one that surprises finance at close, so it is priced at a persistent-volume rate rather than assumed to be free.'
	},
	{
		question: 'What is the real break-even variable?',
		answer:
			'Utilization. Below the break-even utilization percentage in your own inputs, renting wins on total cost regardless of how attractive the sticker price of the hardware looks — and the engine reports that floor explicitly rather than hiding it in a single comparison number.'
	}
];

const post = await fetchPostBySlug('self-hosted-ai-when-to-buy-vs-rent-gpus');
---

<BaseLayout
	title="GPU TCO Analyzer — Local Build vs. Cloud Lease | AIChieve"
	description={description}
	productCta={calculator ? null : null}
>
	<link slot="head" rel="canonical" href={new URL('/tools/gpu-compute/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell
		eyebrow="Compute infrastructure" title="GPU TCO Analyzer" description={description}>
		<div slot="calculator">
			<LocalVsCloudGpuCalculator client:load />
		</div>

	<div slot="film" class="mt-10">
		<div class="ai-panel">
			<div
				class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--ai-line)] px-4 py-3 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-[var(--ai-ink-4)]"
			>
				<span>Launch film · the invoice, not the sticker price</span>
				<span class="flex items-center gap-2">
					<span class="ai-lamp" aria-hidden="true"></span>
					22s · 1920×1080 · narrated
				</span>
			</div>
			<YouTubeEmbed
				id="tKbJ4W91Xfw"
				poster="/media/tool-videos/gpu-compute-brag-poster.jpg"
				label="GPU TCO Analyzer — 22s"
				seconds={22}
			/>
			<div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--ai-line)] px-4 py-3">
				<p class="max-w-xl text-xs leading-6 text-[var(--ai-ink-2)]">
					One Blackwell at street price, six hours a day for three years — every number on screen is
					this calculator's own output.
				</p>
				<span class="flex items-center gap-5 font-mono text-[0.62rem] uppercase tracking-[0.2em]">
					<a class="text-[var(--ai-link)] hover:underline" href="https://youtu.be/tKbJ4W91Xfw" target="_blank" rel="noopener">YouTube</a>
					<a class="text-[var(--ai-ink-3)] hover:text-[var(--ai-signal)]" href="#calculator">Model your own numbers ↓</a>
				</span>
			</div>
		</div>
	</div>

		<article slot="aside" class="ai-panel p-6">
			<p class="ai-label">Operator notes</p>
			<h2 class="mt-3 text-xl font-bold tracking-tight">How to run it</h2>
			<ol class="mt-5 grid gap-4 text-sm leading-7 text-[var(--ai-ink-2)]">
				<li>1. Set sustained active hours per day and days per month — the utilization figure drives everything.</li>
				<li>2. Select the accelerator at street price and add system-component overhead.</li>
				<li>3. Enter your electricity tariff and the persistent storage volume your datasets actually need.</li>
				<li>4. Decide whether production NVIDIA AI Enterprise seats belong in the owned column, then set fleet size for the volume tier.</li>
				<li>5. Read the break-even utilization, not just the headline delta.</li>
			</ol>
			<div class="mt-6 border-t border-[var(--ai-line-soft)] pt-4">
				<p class="ai-label">Model logic</p>
				<p class="mt-2 text-xs leading-6 text-[var(--ai-ink-2)]">
					Owned cost = hardware + commissioning + TDP × tariff × duty cycle + maintenance reserve + software licences − residual value.
					Leased cost = (rate + licence surcharge) × hours × seats + persistent storage.
				</p>
			</div>
		</article>


		<article slot="aside" class="ai-panel p-6">
			<p class="ai-label">FAQ</p>
			<div class="mt-5 grid gap-4">
				{faqItems.map((item) => (
					<div class="border-l-2 border-[var(--ai-line)] pl-4">
						<h3 class="text-sm font-bold tracking-tight text-[var(--ai-ink)]">{item.question}</h3>
						<p class="mt-2 text-xs leading-6 text-[var(--ai-ink-2)]">{item.answer}</p>
					</div>
				))}
			</div>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
