---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import JsonLd from '../../components/JsonLd.astro';
import DecisionIntelligenceCalculator from '../../components/calculators/react/DecisionIntelligenceCalculator';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedArticleCard from '../../components/calculators/RelatedArticleCard.astro';
import { getCalculatorBySlug, getCalculatorSchema } from '../../lib/calculators/metadata';
import { fetchPostBySlug } from '../../lib/wordpress';

const calculator = getCalculatorBySlug('decision-intelligence');
const schema = calculator && Astro.site ? getCalculatorSchema(calculator, Astro.site) : null;

const description =
	'Score a custom build against a bought platform on fully loaded engineer-years, compliance certification, maintenance headcount and roadmap opportunity cost — then stress-test the result for sunk-cost and key-person bias.';

const faqItems = [
	{
		question: 'What makes this figure loaded rather than nominal?',
		answer:
			'The build side is priced in engineer-years at a loaded rate, not headcount months at a salary: compliance certification effort, ongoing maintenance FTE and the roadmap capacity the team gives up while it is maintaining the thing instead of shipping.'
	},
	{
		question: 'Why does the engine ask about sunk cost and key-person risk?',
		answer:
			'Those two biases are what make a build decision get re-affirmed after the arithmetic has already turned. Naming them in the model is the point — the number is only actionable if the argument around it is acknowledged.'
	},
	{
		question: 'Does it cover per-use assets as well as software?',
		answer:
			'The same normalization applies to any asset whose cost splits into a sticker price, an operating cost and an upkeep cost — which is why the engine handles both a CIAM build-versus-buy call and a cost-per-use asset decision with one method.'
	}
];

const post = await fetchPostBySlug('enterprisebuildvsbuy-the-250k-ai-upkeep-tax');
---

<BaseLayout
	title="Master Asset & Software TCO Calculator | AIChieve"
	description={description}
>
	<link slot="head" rel="canonical" href={new URL('/tools/master-asset-tco/', Astro.site).toString()} />
	{schema ? <JsonLd slot="head" data={schema} /> : null}

	<CalculatorShell eyebrow="Build vs. buy" title="Master Asset & Software TCO Calculator" description={description}>
		<div slot="calculator">
			<DecisionIntelligenceCalculator client:load />
		</div>

		<article slot="aside" class="ai-panel p-6">
			<p class="ai-label">Operator notes</p>
			<h2 class="mt-3 text-xl font-bold tracking-tight">How to run it</h2>
			<ol class="mt-5 grid gap-4 text-sm leading-7 text-[var(--ai-ink-2)]">
				<li>1. Pick the mode that matches the decision — enterprise build-vs-buy, cost-per-use, repair-vs-replace, or the tinkering tax.</li>
				<li>2. Load your own rate card: fully loaded engineer-year cost, compliance scope, maintenance headcount.</li>
				<li>3. Read the visible-versus-invisible cost matrix, which is where the off-ledger costs appear.</li>
				<li>4. Complete the bias check before circulating the result — a defensible number with an unexamined premise fails in review.</li>
			</ol>
		</article>

		<article slot="aside" class="ai-panel p-6">
			<p class="ai-label">Formulas</p>
			<div class="mt-5 grid gap-4 border border-[var(--ai-line)] bg-[var(--ai-void)] p-4 font-mono text-[0.7rem] leading-6 text-[var(--ai-ink-2)]">
				<div>
					<p class="font-bold text-[var(--ai-ink)]">Custom build TCO</p>
					<p>build + 3×compliance + 36×maintenance + opportunity</p>
				</div>
				<div>
					<p class="font-bold text-[var(--ai-ink)]">Per-use asset TCO</p>
					<p>sticker + operating + upkeep</p>
				</div>
				<div>
					<p class="font-bold text-[var(--ai-ink)]">Asset tech-debt index</p>
					<p>age × immediate repair cost</p>
				</div>
				<div>
					<p class="font-bold text-[var(--ai-ink)]">Monthly tinkering tax</p>
					<p>troubleshoot hours × value of time</p>
				</div>
			</div>
			<p class="mt-4 text-xs leading-6 text-[var(--ai-ink-2)]">
				Every calculation runs client-side and can be bookmarked or saved locally on your device.
			</p>
		</article>

		<article slot="aside" class="ai-panel p-6">
			<p class="ai-label">FAQ</p>
			<div class="mt-5 grid gap-4">
				{faqItems.map((item) => (
					<div class="border-l-2 border-[var(--ai-line)] pl-4">
						<h3 class="text-sm font-bold tracking-tight text-[var(--ai-ink)]">{item.question}</h3>
						<p class="mt-2 text-xs leading-6 text-[var(--ai-ink-2)]">{item.answer}</p>
					</div>
				))}
			</div>
		</article>

		{post && <RelatedArticleCard slot="aside" post={post} />}
	</CalculatorShell>
</BaseLayout>
