---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { calculators } from '../../lib/calculators/metadata';
import { PRO_APPS, appUrl } from '../../lib/apps';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://aichieve.net';
const pageUrl = `${siteOrigin}/tools/`;

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'AIChieve tools',
	description: 'Deterministic enterprise decision engines for compute, AI stack and software TCO.',
	url: pageUrl,
	numberOfItems: calculators.length,
	itemListElement: calculators.map((tool, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: tool.title,
		url: `${siteOrigin}${tool.href}`
	}))
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
		{ '@type': 'ListItem', position: 2, name: 'Tools', item: pageUrl }
	]
};
---

<BaseLayout
	title="Tool register — deterministic enterprise decision engines | AIChieve"
	description="Deterministic engines that run entirely in your browser: compute TCO, build-vs-buy, agentic breakeven, warehouse payback, inventory accuracy, landed cost and parcel DIM weight."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd slot="head" data={itemListSchema} />
	<JsonLd slot="head" data={breadcrumbSchema} />

	<section class="pt-4">
		<p class="ai-label ai-label--signal">Tool register</p>
		<h1 class="ai-display mt-4 max-w-4xl text-[2.2rem] sm:text-4xl lg:text-5xl">
			Every number yours.
		</h1>
		<p class="ai-lede mt-5">
			The engines below are the deterministic half of AIChieve: you supply the inputs, they return a
			verdict and the arithmetic behind it. Nothing is uploaded, nothing is estimated on your behalf,
			and every one of them stays free.
		</p>
		<div class="mt-5">
			<a href="/tools/interactive-assets/" class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-[var(--ai-signal)] hover:underline">
				&rarr; Explore Embedded Interactive Micro-Assets
			</a>
		</div>
	</section>

	<div class="mt-14 grid gap-4 lg:grid-cols-2">
		{
			calculators.map((tool, index) => (
				<a
					href={tool.href}
					class="ai-panel ai-panel--interactive group flex min-h-64 flex-col justify-between p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ai-signal)]"
				>
					<div>
						<div class="flex items-start justify-between gap-4">
							<span class="ai-tag ai-tag--live">
								<span class="ai-lamp" aria-hidden="true"></span>
								{tool.status}
							</span>
							<span class="font-mono text-[0.6rem] uppercase tracking-[0.18em] text-[var(--ai-ink-4)]">
								{String(index + 1).padStart(2, '0')}
							</span>
						</div>

						<p class="ai-label mt-6">{tool.domainCategory}</p>
						<h2 class="mt-2 text-2xl font-extrabold leading-tight tracking-tight text-[var(--ai-ink)] transition group-hover:text-[var(--ai-signal)]">
							{tool.title}
						</h2>
						<p class="mt-3 text-sm leading-relaxed text-[var(--ai-ink-2)]">{tool.description}</p>
					</div>

					<div class="mt-6 border-t border-[var(--ai-line-soft)] pt-4">
						<p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
							Output · {tool.outputType}
						</p>
						<p class="mt-3 inline-flex items-center gap-1.5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[var(--ai-ink-3)] transition group-hover:text-[var(--ai-signal)]">
							{tool.utility}
							<span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
						</p>
					</div>
				</a>
			))
		}
	</div>

	<section class="mt-20" aria-labelledby="paid-when-needed">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="ai-label">When the decision needs a real file</p>
				<h2 id="paid-when-needed" class="ai-display mt-3 text-2xl sm:text-3xl">
					The paid half
				</h2>
			</div>
			<a class="ai-link text-sm" href="/apps/">
				Full app directory <span aria-hidden="true">→</span>
			</a>
		</div>
		<p class="ai-lede mt-4">
			Engines answer questions you can type in. These answer questions that only exist inside a file —
			a carrier invoice, a vendor’s business case, an AI provider bill, a payout export, a month of
			meter intervals.
		</p>

		<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				PRO_APPS.map((app) => (
					<a
						href={appUrl(app.path)}
						rel="noopener"
						class="ai-panel ai-panel--interactive group flex flex-col justify-between p-5"
					>
						<div>
							<div class="flex items-center justify-between gap-3">
								<span class="ai-tag ai-tag--pro">PRO</span>
								<span class="font-mono text-[0.58rem] uppercase tracking-[0.14em] text-[var(--ai-ink-4)]">
									{app.audience}
								</span>
							</div>
							<h3 class="mt-4 flex items-center gap-1.5 text-lg font-bold tracking-tight text-[var(--ai-ink)] transition group-hover:text-[var(--ai-signal)]">
								{app.name}
								<span aria-hidden="true" class="text-sm opacity-60">↗</span>
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-[var(--ai-ink-2)]">{app.tagline}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
