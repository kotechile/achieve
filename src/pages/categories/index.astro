---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getTopLevelCategories } from '../../lib/categories';

const topLevel = await getTopLevelCategories();
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://aichieve.net';
const pageUrl = `${siteOrigin}/categories/`;

const totalPosts = topLevel.reduce((sum, category) => sum + (category.postCount ?? 0), 0);
---

<BaseLayout
	title="Domains — AI, compute, agentic operations and supply chain | AIChieve"
	description="The domains AIChieve covers: AI stack and tool TCO, autonomous and agentic workflows, compute infrastructure, supply-chain operations and business automation."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd
		slot="head"
		data={{
			'@context': 'https://schema.org',
			'@type': 'CollectionPage',
			name: 'AIChieve domains',
			url: pageUrl
		}}
	/>

	<section class="pt-4">
		<p class="ai-label ai-label--signal">Domains</p>
		<h1 class="ai-display mt-4 max-w-3xl text-[2.2rem] sm:text-4xl lg:text-5xl">
			Five places the money leaks
		</h1>
		<p class="ai-lede mt-5">
			{totalPosts} dispatches across the operating domains an enterprise architect, AI strategist or
			supply-chain manager is actually accountable for. Counts are read from the live CMS.
		</p>
	</section>

	<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			topLevel.map((domain) => (
				<a
					href={`/categories/${domain.slug}/`}
					class="ai-panel ai-panel--interactive group flex flex-col justify-between p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ai-signal)]"
				>
					<div>
						<div class="flex items-start justify-between gap-4">
							<span class="ai-label">{domain.slug}</span>
							<span class="font-mono text-sm font-bold text-[var(--ai-ink-2)] tabular-nums">
								{domain.postCount ?? 0}
							</span>
						</div>
						<h2 class="mt-4 text-xl font-extrabold leading-snug tracking-tight text-[var(--ai-ink)] transition group-hover:text-[var(--ai-signal)]">
							{domain.name}
						</h2>
						{domain.description && (
							<p class="mt-3 text-sm leading-relaxed text-[var(--ai-ink-2)]">{domain.description}</p>
						)}
					</div>

					{domain.children.length > 0 && (
						<ul class="mt-6 grid gap-2 border-t border-[var(--ai-line-soft)] pt-4">
							{domain.children.map((child) => (
								<li class="flex items-center justify-between gap-3 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-[var(--ai-ink-4)]">
									<span class="truncate">{child.name}</span>
									<span class="tabular-nums">{child.postCount ?? 0}</span>
								</li>
							))}
						</ul>
					)}

					<span class="mt-6 inline-flex items-center gap-1.5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[var(--ai-ink-3)] transition group-hover:text-[var(--ai-signal)]">
						Open domain
						<span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
					</span>
				</a>
			))
		}
	</div>
</BaseLayout>
