---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { PRO_APPS, appUrl, getAppsBase } from '../../lib/apps';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://aichieve.net';
const pageUrl = `${siteOrigin}/apps/`;

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'AIChieve PRO apps',
	url: pageUrl,
	numberOfItems: PRO_APPS.length,
	itemListElement: PRO_APPS.map((app, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: app.name,
		url: appUrl(app.path)
	}))
};
---

<BaseLayout
	title="PRO apps — invoice, vendor-case and payout audits | AIChieve"
	description="Buyer-side audits that run on your own files: AI provider invoice reconciliation, carrier DIM-weight and surcharge audit, warehouse automation case review, EU e-invoice gating and Stripe payout reconciliation."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd slot="head" data={itemListSchema} />

	<section class="pt-4">
		<p class="ai-label ai-label--signal">PRO apps</p>
		<h1 class="ai-display mt-4 max-w-4xl text-[2.2rem] sm:text-4xl lg:text-5xl">
			Audits that run on the file, not on opinion.
		</h1>
		<p class="ai-lede mt-5">
			Each app exists because a specific class of money leaves an organisation through a document
			nobody re-derived. You hand it your own file; it returns what was charged, what the rule
			actually was, and which lines do not reconcile.
		</p>
		<div class="mt-7 flex flex-wrap items-center gap-3">
			<span class="ai-tag ai-tag--pro">{PRO_APPS.length} apps live</span>
			<span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
				Hosted at {getAppsBase().replace('https://', '')}
			</span>
		</div>
	</section>

	<div class="mt-14 grid gap-4 lg:grid-cols-2">
		{
			PRO_APPS.map((app, index) => (
				<a
					href={appUrl(app.path)}
					rel="noopener"
					class="ai-panel ai-panel--interactive group flex flex-col justify-between p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ai-signal)]"
				>
					<div>
						<div class="flex items-start justify-between gap-4">
							<span class="ai-tag ai-tag--pro">PRO</span>
							<span class="font-mono text-[0.6rem] uppercase tracking-[0.18em] text-[var(--ai-ink-4)]">
								{String(index + 1).padStart(2, '0')} · {app.audience}
							</span>
						</div>

						<h2 class="mt-6 flex items-center gap-2 text-2xl font-extrabold tracking-tight text-[var(--ai-ink)] transition group-hover:text-[var(--ai-signal)]">
							{app.name}
							<span aria-hidden="true" class="text-base opacity-60">↗</span>
						</h2>
						<p class="mt-2 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-[var(--ai-signal)]">
							{app.tagline}
						</p>

						<dl class="mt-5 grid gap-3 border-t border-[var(--ai-line-soft)] pt-5 text-sm">
							<div>
								<dt class="ai-label">You supply</dt>
								<dd class="mt-1 leading-relaxed text-[var(--ai-ink-2)]">{app.input}</dd>
							</div>
							<div>
								<dt class="ai-label">You get back</dt>
								<dd class="mt-1 leading-relaxed text-[var(--ai-ink-2)]">{app.output}</dd>
							</div>
							<div>
								<dt class="ai-label">Failure it catches</dt>
								<dd class="mt-1 leading-relaxed text-[var(--ai-ink-2)]">{app.failure}</dd>
							</div>
						</dl>
					</div>

					<span class="mt-6 inline-flex items-center gap-1.5 border-t border-[var(--ai-line-soft)] pt-4 font-mono text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[var(--ai-ink-3)] transition group-hover:text-[var(--ai-signal)]">
						Open {app.name}
						<span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">↗</span>
					</span>
				</a>
			))
		}
	</div>

	<section class="mt-20 border-t border-[var(--ai-line)] pt-10">
		<div class="grid gap-8 lg:grid-cols-[0.4fr_0.6fr]">
			<div>
				<p class="ai-label">Free first</p>
				<h2 class="ai-display mt-3 text-2xl sm:text-3xl">Try the arithmetic before the app</h2>
			</div>
			<div>
				<p class="text-sm leading-relaxed text-[var(--ai-ink-2)]">
					Both deterministic engines on this site stay free and run in your browser. If a decision
					turns out to need file-level work, the matching app is named on the page that raised it —
					and nowhere else.
				</p>
				<a class="ai-link mt-5 text-sm" href="/tools/">
					Open the tool register <span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
