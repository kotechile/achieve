---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { OVERVIEW } from '../lib/overview';
import { SIBLING_SITE, SITE_AUTHOR, OWNED_POST_SLUGS } from '../lib/site-content';
import { PRO_APPS } from '../lib/apps';
import { calculators } from '../lib/calculators/metadata';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://aichieve.net';
const pageUrl = `${siteOrigin}/about/`;
const authorUrl = `${siteOrigin}${SITE_AUTHOR.href}`;
---

<BaseLayout
	title="About the lab — applied AI & operations engineering | AIChieve"
	description="AIChieve is an independent applied AI and operations lab by Jorge Fernandez: human-in-the-loop research, deterministic client-side engines and file-based audit prototypes."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd
		slot="head"
		data={{
			'@context': 'https://schema.org',
			'@type': 'AboutPage',
			name: 'About AIChieve',
			url: pageUrl,
			description: OVERVIEW.subheadline,
			author: { '@type': 'Person', name: SITE_AUTHOR.name, url: authorUrl }
		}}
	/>

	<section class="pt-4">
		<p class="ai-label ai-label--signal">{OVERVIEW.eyebrow}</p>
		<h1 class="ai-display mt-4 max-w-4xl text-[2.2rem] sm:text-4xl lg:text-5xl">{OVERVIEW.headline}</h1>
		<p class="ai-lede mt-6">{OVERVIEW.subheadline}</p>
		<p class="mt-6 max-w-2xl text-sm leading-relaxed text-[var(--ai-ink-2)]">
			{OVERVIEW.mission}
		</p>
		<p
			class="mt-5 max-w-2xl border-l-2 border-[var(--ai-signal)]/50 pl-4 text-sm leading-relaxed text-[var(--ai-ink-2)]"
		>
			{OVERVIEW.now}
		</p>
	</section>

	<div class="mt-12 grid gap-4 sm:grid-cols-3">
		<div class="ai-panel p-6">
			<p class="ai-kpi__value">{OWNED_POST_SLUGS.size}</p>
			<p class="ai-label mt-2">Operations dispatches</p>
		</div>
		<div class="ai-panel p-6">
			<p class="ai-kpi__value">{calculators.length}</p>
			<p class="ai-label mt-2">Free deterministic engines</p>
		</div>
		<div class="ai-panel p-6">
			<p class="ai-kpi__value ai-kpi__value--signal">{PRO_APPS.length}</p>
			<p class="ai-label mt-2">PRO audit prototypes</p>
		</div>
	</div>

	{/* 01 — what the sandbox is. The three-column meta strip exists so the scale is legible
	    without inflating it: one builder, one pipeline fleet, one property. */}
	<section class="mt-20 grid gap-10 lg:grid-cols-[0.38fr_0.62fr]" aria-labelledby="lab-heading">
		<div>
			<p class="ai-label ai-label--signal">// 01 The Lab</p>
			<h2 id="lab-heading" class="ai-display mt-3 text-2xl sm:text-3xl">{OVERVIEW.lab.title}</h2>
			<p class="mt-4 text-sm leading-relaxed text-[var(--ai-ink-2)]">{OVERVIEW.originStory}</p>
		</div>
		<div class="grid gap-5">
			{
				OVERVIEW.lab.body.map((paragraph) => (
					<p class="text-base leading-relaxed text-[var(--ai-ink-2)]">{paragraph}</p>
				))
			}
			<dl
				class="mt-2 grid grid-cols-1 gap-px border border-[var(--ai-line)] bg-[var(--ai-line-soft)] sm:grid-cols-3"
			>
				<div class="bg-[var(--ai-panel)] px-4 py-4">
					<dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">Built by</dt>
					<dd class="mt-1.5 text-sm font-semibold text-[var(--ai-ink)]">1 architect</dd>
				</div>
				<div class="bg-[var(--ai-panel)] px-4 py-4">
					<dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">Drafted by</dt>
					<dd class="mt-1.5 text-sm font-semibold text-[var(--ai-ink)]">Agent pipelines</dd>
				</div>
				<div class="bg-[var(--ai-panel)] px-4 py-4">
					<dt class="font-mono text-[0.58rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">Verified by</dt>
					<dd class="mt-1.5 text-sm font-semibold text-[var(--ai-signal)]">A human, each time</dd>
				</div>
			</dl>
		</div>
	</section>

	{/* 02 — the guardrails. This is the section a skeptical reader is looking for, so it is
	    structured as claims with a reason attached rather than three adjectives. */}
	<section class="mt-20" aria-labelledby="methodology-heading">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<p class="ai-label ai-label--signal">// 02 The Methodology</p>
				<h2 id="methodology-heading" class="ai-display mt-3 text-2xl sm:text-3xl">
					How a tool gets made — and what it has to pass
				</h2>
			</div>
			<p class="max-w-sm text-sm leading-relaxed text-[var(--ai-ink-2)]">
				Where the tools come from, and the gates every one of them passes before it ships.
			</p>
		</div>

		<div class="mt-8 border-y border-[var(--ai-line)]">
			{
				OVERVIEW.methodology.map((section, index) => (
					<div class="grid gap-4 border-b border-[var(--ai-line-soft)] py-7 last:border-b-0 sm:grid-cols-[3rem_0.34fr_0.66fr] sm:items-start">
						<span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="text-lg font-bold tracking-tight text-[var(--ai-ink)]">{section.title}</h3>
						<p class="text-sm leading-relaxed text-[var(--ai-ink-2)]">{section.body}</p>
					</div>
				))
			}
		</div>
	</section>

	{/* 03 — the builder, then the disclaimer in the same block. The disclaimer is deliberately
	    prominent: a personal lab publishing vendor-cost analysis needs its independence stated
	    where the bio is, not buried in a footer. */}
	<section class="mt-20" aria-labelledby="architect-heading">
		<p class="ai-label ai-label--signal">// 03 The Architect</p>
		<div class="mt-6 grid gap-10 lg:grid-cols-[0.34fr_0.66fr]">
			<div>
				<div class="flex items-center gap-4">
					<div
						class="grid h-16 w-16 shrink-0 place-items-center border border-[var(--ai-signal)] font-mono text-xl font-bold text-[var(--ai-signal)]"
						aria-hidden="true"
					>
						{SITE_AUTHOR.initials}
					</div>
					<div>
						<h2 id="architect-heading" class="ai-display text-2xl sm:text-3xl">
							{OVERVIEW.architect.title}
						</h2>
						<p
							class="mt-2 font-mono text-[0.6rem] uppercase leading-relaxed tracking-[0.16em] text-[var(--ai-ink-4)]"
						>
							{SITE_AUTHOR.role}
						</p>
					</div>
				</div>
				<a class="ai-link mt-5 inline-block text-sm" href={SITE_AUTHOR.href}>
					Full profile <span aria-hidden="true">→</span>
				</a>
			</div>

			<div class="grid gap-5">
				{
					OVERVIEW.architect.body.map((paragraph) => (
						<p class="text-base leading-relaxed text-[var(--ai-ink-2)]">{paragraph}</p>
					))
				}
				<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[var(--ai-ink-2)]">
					<span class="ai-label">Also runs</span>
					<a class="ai-link" href={SIBLING_SITE.origin} rel="noopener" target="_blank">
						{SIBLING_SITE.name} — personal &amp; career decisions <span aria-hidden="true">↗</span>
					</a>
				</p>

				<aside class="ai-panel border-[var(--ai-signal)] p-5">
					<p class="font-mono text-[0.6rem] uppercase tracking-[0.18em] text-[var(--ai-signal)]">
						Independence disclaimer
					</p>
					<p class="mt-3 text-sm leading-relaxed text-[var(--ai-ink-2)]">
						{OVERVIEW.architect.disclaimer}
					</p>
				</aside>
			</div>
		</div>
	</section>

	<section class="mt-20 border-t border-[var(--ai-line)] pt-10">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 class="ai-display text-2xl sm:text-3xl">Start with the arithmetic</h2>
				<p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--ai-ink-2)]">
					Every engine is free, runs in your browser, and takes a few minutes to fill in.
				</p>
			</div>
			<a class="ai-btn" href="/tools/">
				Open the tool register <span aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</BaseLayout>
