---
/**
 * Privacy policy.
 *
 * Exists for two reasons: LinkedIn requires a policy URL before it will verify the profile link on
 * this site, and the site now loads a third-party consent script (Cookiebot), which has to be
 * disclosed where a reader can find it.
 *
 * Every claim here is checkable against the code: the analytics tag in `layouts/BaseLayout.astro`
 * (self-hosted Umami, no cookie), the Cookiebot tag beside it, and the WordPress install that serves
 * article bodies at build time. Update this file when any of those change — a policy that describes
 * a site that no longer exists is worse than no policy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_AUTHOR, SIBLING_SITE } from '../lib/site-content';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') || 'https://aichieve.net';
const pageUrl = `${siteOrigin}/privacy/`;
const updated = '3 November 2026';

const sections = [
	{
		id: 'who',
		title: 'Who runs this site',
		body: [
			`AIChieve.net is an independent personal research and software engineering project, run by ${SITE_AUTHOR.name}. It is not a company, and there is no data team behind it — one person maintains the site and the pipelines that feed it.`,
			'For anything in this policy, including a request about your own data, contact the address at the bottom of this page.'
		]
	},
	{
		id: 'collected',
		title: 'What is collected',
		body: [
			'There are no accounts, no login, no newsletter and no comment system, so the site never asks you for personal details.',
			'**Hosting logs.** The server that serves these pages records the usual request data: the page requested, the time, the referring page and your IP address. The hosting provider keeps it for security and abuse prevention.',
			'**Aggregate traffic measurement.** Page views are counted with Umami, a self-hosted analytics tool that runs on this same infrastructure. It sets no cookies, does not fingerprint the browser and does not build a profile that follows you to other sites.',
			'**Consent records.** If you answer the cookie banner, Cookiebot stores your choice so the site can respect it on the next page. That record holds your consent state and an identifier for the browser session, not your identity.',
			'**Email.** If you write to me, I keep the message and your address so I can reply. Nothing else is done with it.'
		]
	},
	{
		id: 'not-collected',
		title: 'What is not collected',
		body: [
			'No advertising identifiers, no cross-site tracking, no data brokers, no sale or rental of anything to anyone. There is no ad tech on this site and no social embed that reports your visit back to a platform.',
			'The calculators use a different rule on purpose. Every number you type into one is computed in your own browser by deterministic code, and nothing is uploaded. You can disconnect the network and they still work.'
		]
	},
	{
		id: 'cookies',
		title: 'Cookies and consent',
		body: [
			'The site itself sets no cookies for reading. The banner you see is served by Cookiebot, which stores your answer in a first-party cookie named `CookieConsent` so the question is not asked twice. It may also keep a session ticket while you are on the page.',
			'Preferences can be changed or withdrawn at any time. Use the cookie icon in the bottom corner of the page, or clear the site data in your browser — the banner will ask again on your next visit. Withdrawing consent never blocks the reading experience: every article and every calculator works without it.'
		]
	},
	{
		id: 'third-parties',
		title: 'Third parties',
		body: [
			'**Cookiebot (Usercentrics A/S)** serves the consent banner. It receives the request for the banner script, which means your IP address reaches it. Nothing else about you is sent.',
			'**The hosting provider** runs the servers for this site, its analytics instance and the PRO applications. Server logs stay with that provider under its own terms.',
			'**WordPress** is the content system behind these pages. Article bodies are fetched at build time, so reading a page here does not contact it.',
			'**LinkedIn** hosts the professional profile linked from this site. Following that link takes you to LinkedIn, where its own privacy policy applies.'
		]
	},
	{
		id: 'legal',
		title: 'Legal bases and your rights',
		body: [
			'Where the GDPR applies: server logs rest on legitimate interest in keeping the site available and safe. Cookiebot records rest on your consent, which you can withdraw at any time.',
			'You can ask for a copy of what is held about you, ask for it to be corrected or erased, or object to processing. Write to the address below and the answer comes from a person, not a form letter.',
			'If you are unhappy with the response, you can complain to the data protection authority in your country of residence.'
		]
	},
	{
		id: 'retention',
		title: 'How long things are kept',
		body: [
			'Hosting logs are kept for the short retention window the provider applies. Consent records last until you withdraw them or the cookie expires. Emails are kept while the conversation is useful, then deleted.'
		]
	},
	{
		id: 'apps',
		title: 'The PRO applications',
		body: [
			'The audit applications run on a separate subdomain (`apps.aichieve.net`) and are covered by the notice shown inside each one, because they handle files you upload. This page covers the site you are reading.'
		]
	},
	{
		id: 'changes',
		title: 'Changes to this policy',
		body: [
			'If the way the site handles data changes, this page changes with it and the date at the top moves. There is no mailing list to notify, so the date is the signal.'
		]
	}
];
---

<BaseLayout
	title="Privacy policy | AIChieve"
	description="What aichieve.net collects, what it does not, how cookies and consent work, and how to reach the person who runs it."
>
	<link slot="head" rel="canonical" href={pageUrl} />
	<JsonLd
		slot="head"
		data={{
			'@context': 'https://schema.org',
			'@type': 'WebPage',
			name: 'Privacy policy',
			url: pageUrl,
			dateModified: '2026-11-03',
			description:
				'What aichieve.net collects, what it does not, how cookies and consent work, and who to contact.',
			author: {
				'@type': 'Person',
				name: SITE_AUTHOR.name,
				url: `${siteOrigin}${SITE_AUTHOR.href}`,
				sameAs: [SITE_AUTHOR.linkedin]
			},
			isPartOf: { '@type': 'WebSite', name: 'AIChieve', url: `${siteOrigin}/` }
		}}
	/>

	<section class="pt-4">
		<p class="ai-label ai-label--signal">Legal</p>
		<h1 class="ai-display mt-4 max-w-4xl text-[2.2rem] sm:text-4xl lg:text-5xl">Privacy policy</h1>
		<p class="ai-lede mt-6">
			This site counts visits and asks about cookies. That is the whole of it — here is exactly what
			that means, in the same plain terms as everything else on AIChieve.
		</p>
		<p class="mt-6 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-[var(--ai-ink-4)]">
			Last updated · {updated}
		</p>
	</section>

	<nav class="mt-10 border-y border-[var(--ai-line)] py-4" aria-label="Policy contents">
		<p class="ai-label">On this page</p>
		<ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
			{
				sections.map((section) => (
					<li>
						<a class="ai-link" href={`#${section.id}`}>
							{section.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="mt-12 grid gap-12 lg:grid-cols-[0.34fr_0.66fr]">
		<div class="grid gap-2 lg:sticky lg:top-24 lg:self-start">
			<p class="ai-label">Summary</p>
			<p class="mt-2 text-sm leading-relaxed text-[var(--ai-ink-2)]">
				No accounts, no advertising, no data sold. Visit counts stay on infrastructure I run.
				Consent covers the banner and can be withdrawn at any time.
			</p>
		</div>

		<div class="grid gap-10">
			{
				sections.map((section) => (
					<section id={section.id} class="scroll-mt-28" aria-labelledby={`${section.id}-heading`}>
						<h2 id={`${section.id}-heading`} class="ai-display text-xl sm:text-2xl">
							{section.title}
						</h2>
						<div class="mt-4 grid gap-4">
							{section.body.map((paragraph) => (
								<p
									class="text-sm leading-relaxed text-[var(--ai-ink-2)] sm:text-base"
									set:html={paragraph.replace(
										/\*\*(.+?)\*\*/g,
										'<strong class="font-semibold text-[var(--ai-ink)]">$1</strong>'
									)}
								/>
							))}
						</div>
					</section>
				))
			}
		</div>
	</div>

	<section class="mt-16 border-t border-[var(--ai-line)] pt-10" aria-labelledby="contact-heading">
		<p class="ai-label ai-label--signal">Contact</p>
		<h2 id="contact-heading" class="ai-display mt-3 text-2xl sm:text-3xl">Ask a person</h2>
		<p class="mt-4 max-w-2xl text-sm leading-relaxed text-[var(--ai-ink-2)]">
			Write to <a class="ai-link" href="mailto:kotechile@gmail.com">kotechile@gmail.com</a> for anything
			about data on this site — a copy of what is held, a correction, an erasure, or a question about
			this policy. A message on
			<a class="ai-link" href={SITE_AUTHOR.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
			reaches the same person.
		</p>
		<p class="mt-6 text-sm leading-relaxed text-[var(--ai-ink-2)]">
			The other property, <a class="ai-link" href={SIBLING_SITE.origin} rel="noopener" target="_blank"
				>{SIBLING_SITE.name}</a
			>, publishes its own notice.
		</p>
	</section>
</BaseLayout>
