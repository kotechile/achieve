---
/**
 * The one place a reader is told the matching paid tool exists.
 *
 * Rendered only when `productCtaFor()` found an honest match for the page (see `lib/product-cta.ts`),
 * so it never appears as a generic banner. Copy is deliberately plain: what the tool does with the
 * reader's own file, and that it is a separate paid tool.
 */
import type { ProductCta } from '../lib/product-cta';

interface Props {
	match: ProductCta;
}

const { match } = Astro.props;
---

<section class="ai-wrap pb-16 pt-6" aria-labelledby="product-cta-heading">
	<div class="ai-panel ai-panel--cap p-6 sm:p-8">
		<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
			<div class="max-w-3xl">
				<p class="ai-label ai-label--signal">Paid tool · runs on your own file</p>
				<h2 id="product-cta-heading" class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">
					{match.name}
				</h2>
				<p class="mt-3 text-sm leading-relaxed text-[var(--ai-ink-2)] sm:text-base">{match.why}</p>
				<p class="mt-3 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
					{match.tagline}
				</p>
			</div>
			<div class="flex shrink-0 flex-col items-start gap-3">
				<a class="ai-btn" href={match.url} rel="noopener">
					Open {match.name} <span aria-hidden="true">↗</span>
				</a>
				<p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
					Every engine on this site stays free
				</p>
			</div>
		</div>
	</div>
</section>
