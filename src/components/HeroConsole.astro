---
/**
 * Command Deck hero.
 *
 * Every number on this panel is read from the live WordPress install or from the tool/app
 * registers — there are no illustrative statistics here, per the honesty rule the design
 * system enforces (invented proof is the fastest way to make an operations audience distrust
 * the whole property).
 */
import { OVERVIEW } from '../lib/overview';

interface DomainRow {
	name: string;
	slug: string;
	postCount: number | null;
}

interface Props {
	domains: DomainRow[];
	dispatchCount: number;
	engineCount: number;
	appCount: number;
}

const { domains, dispatchCount, engineCount, appCount } = Astro.props;
// The caller has already de-duplicated the taxonomy into browsable domains and sorted them by
// volume. Do NOT re-filter on hierarchy here: the largest domain (supply-chain-operations) is a
// top-level category, and filtering to children only quietly dropped it from the board.
const board = domains.slice(0, 6);

/**
 * Real build time, not a relative "updated 2m ago".
 *
 * This is a static build: the counts come from the CMS at build time and then never change
 * until the next deploy. A relative stamp would be frozen at whatever it said when the page
 * was generated — it would read "2m ago" for as long as the build sat there, which is a false
 * claim dressed as a live signal. An absolute stamp is the honest version of the same idea.
 */
const builtAt = new Date();
const buildStamp = builtAt
	.toLocaleString('en-GB', {
		day: '2-digit',
		month: 'short',
		year: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
		timeZone: 'UTC',
		hour12: false
	})
	.toUpperCase();
---

<section class="pt-6 sm:pt-10" aria-labelledby="hero-heading">
	<div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-16">
		<div class="ai-rise">
			<p class="ai-label ai-label--signal">{OVERVIEW.eyebrow}</p>

			<h1
				id="hero-heading"
				class="ai-display ai-display--hero mt-5 text-[2.6rem] sm:text-6xl lg:text-[4.25rem]"
			>
				{OVERVIEW.headline}
			</h1>

			<p class="ai-lede mt-6">
				{OVERVIEW.subheadline}
			</p>

			<div class="mt-8 flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-7">
				<a class="ai-btn" href="/tools/">
					Open the tool register
					<span aria-hidden="true">→</span>
				</a>
				<!-- Secondary is a text link on purpose: a second bordered control in this row
				     competed with the amber fill and split the eye. One press-me per hero. -->
				<a class="ai-link ai-link--mono" href="/apps/">
					See the PRO apps <span aria-hidden="true">→</span>
				</a>
			</div>

			{/* Each readout is a link to the section it counts, so the hover state is an honest
			    affordance rather than decoration on something inert. The third line says what
			    the number actually represents. */}
			<div class="mt-12 grid grid-cols-3 gap-6 border-t border-[var(--ai-line)] pt-8">
				<a class="ai-kpi" href="/articles/">
					<span class="ai-kpi__value">{dispatchCount}</span>
					<span class="ai-label">Dispatches</span>
					<span class="ai-kpi__sub">Across {domains.length} domains</span>
				</a>
				<a class="ai-kpi border-l border-[var(--ai-line)] pl-6" href="/tools/">
					<span class="ai-kpi__value">{engineCount}</span>
					<span class="ai-label">Engines</span>
					<span class="ai-kpi__sub">Deterministic, browser-side</span>
				</a>
				<a class="ai-kpi border-l border-[var(--ai-line)] pl-6" href="/apps/">
					<span class="ai-kpi__value ai-kpi__value--signal">{appCount}</span>
					<span class="ai-label">PRO apps</span>
					<span class="ai-kpi__sub">Paid, runs on your file</span>
				</a>
			</div>
		</div>

		<div class="ai-rise" style="animation-delay: 80ms">
			<div class="ai-panel ai-panel--cap">
				<div
					class="flex items-center justify-between gap-3 border-b border-[var(--ai-line)] px-4 py-3 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-[var(--ai-ink-4)]"
				>
					<span>Coverage board</span>
					<span class="flex items-center gap-2">
						<span class="ai-lamp" aria-hidden="true"></span>
						Live
						<span class="text-[var(--ai-ink-4)]" aria-hidden="true">·</span>
						<span class="tabular-nums">{buildStamp}</span>
					</span>
				</div>

				{/* Rows filter the dispatch log further down the page in place — the point is to
				    narrow the streams without losing your position. The full category page is one
				    click from the board footer, so nothing here is a dead end. Escape clears. */}
				<ul id="coverage-board">
					{
						board.map((domain, index) => (
							<li>
								<button
									type="button"
									class="ai-board-row"
									data-filter-domain={domain.slug}
									aria-pressed="false"
									aria-label={`Filter the dispatch log to ${domain.name}`}
								>
									<span class="min-w-0">
										<span class="ai-board-row__name block truncate text-sm font-semibold text-[var(--ai-ink)] transition">
											{domain.name}
										</span>
										<span class="mt-1 block font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
											{domain.slug}
										</span>
									</span>
									<span class="shrink-0 font-mono text-sm font-bold text-[var(--ai-ink-2)] tabular-nums">
										{domain.postCount ?? 0}
									</span>
								</button>
							</li>
						))
					}
				</ul>

				<div class="flex items-center justify-between gap-3 border-t border-[var(--ai-line)] px-4 py-3">
					<p class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)]">
						Counts read from the live CMS at build time
					</p>
					<a class="ai-link text-[0.65rem]" href="/categories/">
						All domains <span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
