---
import { getTopLevelCategories } from '../lib/categories';
import { PRO_APPS } from '../lib/apps';
import { SIBLING_SITE, OWNED_POST_SLUGS } from '../lib/site-content';

const domains = await getTopLevelCategories();
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--ai-line)] bg-[var(--ai-shell)] pt-14 pb-10">
	<div class="ai-wrap">
		<div class="grid gap-10 lg:grid-cols-12">
			<div class="lg:col-span-5">
				<p class="ai-label">AIChieve // Enterprise</p>
				<h2 class="mt-3 text-2xl font-extrabold tracking-tight text-[var(--ai-ink)]">
					Cost control for the systems your business already runs on.
				</h2>
				<p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--ai-ink-2)]">
					Deterministic engines and buyer-side audits for AI stack economics, agentic workflow
					operations, and supply-chain spend.
				</p>
				<p class="mt-5 font-mono text-[0.68rem] uppercase tracking-[0.18em] text-[var(--ai-ink-4)]">
					{OWNED_POST_SLUGS.size} dispatches · {PRO_APPS.length} PRO apps · 2 engines
				</p>
			</div>

			<nav class="lg:col-span-3" aria-label="Footer navigation">
				<p class="ai-label">Directory</p>
				<div class="mt-4 grid gap-2.5 text-sm">
					<a class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]" href="/tools/">Tools</a>
					<a class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]" href="/apps/">PRO Apps</a>
					<a class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]" href="/articles/">Article archive</a>
					<a class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]" href="/categories/">Domains</a>
					<a class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]" href="/about/">About</a>
				</div>
			</nav>

			<nav class="lg:col-span-2" aria-label="Domain navigation">
				<p class="ai-label">Domains</p>
				<div class="mt-4 grid gap-2.5 text-sm">
					{domains.map((domain) => (
						<a
							class="truncate text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]"
							href={`/categories/${domain.slug}/`}
							title={domain.name}
						>
							{domain.name}
						</a>
					))}
				</div>
			</nav>

			<div class="lg:col-span-2">
				<p class="ai-label">Personal side</p>
				<div class="mt-4 grid gap-2.5 text-sm">
					<a
						class="text-[var(--ai-ink-2)] transition hover:text-[var(--ai-signal)]"
						href={SIBLING_SITE.origin}
						target="_blank"
						rel="noopener"
					>
						{SIBLING_SITE.name} ↗
					</a>
					<p class="text-xs leading-relaxed text-[var(--ai-ink-4)]">
						Career, compensation, expat tax and personal TCO live there.
					</p>
				</div>
			</div>
		</div>

		<div
			class="mt-12 flex flex-col gap-3 border-t border-[var(--ai-line-soft)] pt-6 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--ai-ink-4)] sm:flex-row sm:items-center sm:justify-between"
		>
			<p>© {year} AIChieve. All rights reserved.</p>
			<p class="flex items-center gap-2">
				<span class="ai-lamp" aria-hidden="true"></span>
				<span>Deterministic engines · client-side</span>
			</p>
		</div>
	</div>
</footer>
