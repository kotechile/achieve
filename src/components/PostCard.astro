---
import type { WordPressPost } from '../lib/wordpress';

interface Props {
	post: WordPressPost;
}

const { post } = Astro.props;

function formatDate(dateStr: string | null) {
	if (!dateStr) return null;
	try {
		return new Date(dateStr).toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric'
		});
	} catch {
		return null;
	}
}

const date = formatDate(post.date);
---

<article class="h-full">
	<a
		href={`/${post.slug}/`}
		class="ai-panel ai-panel--interactive group flex h-full flex-col focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ai-signal)]"
	>
		{
			post.featuredImage ? (
				<div class="aspect-[16/9] overflow-hidden border-b border-[var(--ai-line)]">
					<img
						src={post.featuredImage}
						alt={post.featuredImageAlt || ''}
						loading="lazy"
						class="h-full w-full object-cover opacity-85 transition duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-100"
					/>
				</div>
			) : (
				<div class="aspect-[16/9] border-b border-[var(--ai-line)] bg-[var(--ai-panel-2)]" aria-hidden="true"></div>
			)
		}

		<div class="flex flex-1 flex-col p-5">
			<div class="flex items-center justify-between gap-3">
				<span class="ai-label truncate">{post.categoryLabel ?? 'Dispatch'}</span>
				{date && <time class="font-mono text-[0.62rem] tracking-[0.1em] text-[var(--ai-ink-4)]" datetime={post.date || ''}>{date}</time>}
			</div>

			<h3 class="mt-4 text-pretty text-lg font-bold leading-snug tracking-tight text-[var(--ai-ink)] transition group-hover:text-[var(--ai-signal)]">
				{post.title}
			</h3>

			{
				post.excerpt && (
					<p class="mt-3 flex-1 text-pretty text-sm leading-relaxed text-[var(--ai-ink-2)] line-clamp-3">{post.excerpt}</p>
				)
			}

			<span class="mt-5 inline-flex items-center gap-1.5 border-t border-[var(--ai-line-soft)] pt-4 font-mono text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[var(--ai-ink-3)] transition group-hover:text-[var(--ai-signal)]">
				Open dispatch
				<span aria-hidden="true" class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
			</span>
		</div>
	</a>
</article>
