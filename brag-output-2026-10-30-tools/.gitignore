# The renderer's scratch state.
*/composition/.hyperframes/

# Reproducible inputs: fonts come from the previous run, music and SFX from the brag skill, and the
# narration is regenerated by build-videos.py. Committing ~18MB of them buys nothing.
*/composition/assets/

# Render output is an upload artefact and is regenerated in under a minute per film. The 4K master is
# ~29MB; five of them in git is 150MB of binary that no test reads.
*/brag*.mp4
