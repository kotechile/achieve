PUBLIC_SITE_URL=https://aichieve.net
# The shared WordPress install. aichieve.net reads the SAME CMS as giniloh.com and filters it
# through src/lib/site-content.ts — no content is duplicated into a second CMS.
PUBLIC_WORDPRESS_API_BASE=https://cms.giniloh.com
PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Product host for the PRO apps (LedgerLink, FacturGate, ParcelProof, CaseProof, SpendProof).
# Switch this to https://apps.aichieve.net once that host is provisioned; until then the live
# product host is the existing apps.giniloh.com deployment.
PUBLIC_APPS_BASE=https://apps.giniloh.com

# Privacy-first Lightweight Analytics (e.g., Umami)
PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
PUBLIC_ANALYTICS_WEBSITE_ID=your_website_id_here
PUBLIC_ANALYTICS_DOMAINS=aichieve.net,www.aichieve.net

# Search Console Verification Keys
PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_code_here
PUBLIC_BING_SITE_VERIFICATION=your_bing_code_here
